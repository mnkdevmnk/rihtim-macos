/* Settings */
"The app has to be in /Applications." = "Die App muss in /Applications liegen.";
"More than %d windows" = "Mehr als %d Fenster";
"dark %@" = "dunkel %@";
"light %@" = "hell %@";
"Measured Dock glass: %d pt · strip: %d pt" = "Gemessenes Dock-Glas: %d pt · Leiste: %d pt";
"Open delay: %.2f s" = "Öffnungsverzögerung: %.2f s";
"Slide duration: %.2f s" = "Gleitdauer: %.2f s";
"Coffee off, the Mac sleeps as usual" = "Kaffee aus, der Mac schläft wie gewohnt";
"Turn on indefinitely" = "Unbegrenzt einschalten";
"Boost: %@" = "Zuwachs: %@";
"First bring brightness to 100%% the normal way, then hold ⌘ and press brightness up to go past 100%% (like Sapphire); the level shows in the notch. Lowering regular brightness turns extra brightness off. This display offers up to %.1f× EDR headroom, and the boost never goes beyond what it can give at the moment. Uses more battery." = "Stell die Helligkeit zuerst normal auf 100 %%, halte dann ⌘ und drücke heller, um über 100 %% zu gehen (wie Sapphire); die Stufe erscheint in der Notch. Senkst du die normale Helligkeit, schaltet sich die Extra-Helligkeit ab. Dieser Bildschirm bietet bis zu %.1f× EDR-Spielraum, und der Zuwachs geht nie über das hinaus, was er gerade liefern kann. Verbraucht mehr Akku.";
"Clear history (%d)" = "Verlauf leeren (%d)";
"Files on the shelf aren't copied, only their locations are remembered. %d files right now." = "Dateien in der Ablage werden nicht kopiert, nur ihr Ort wird gemerkt. Derzeit %d Dateien.";
"Open width: %d pt" = "Breite geöffnet: %d pt";
"Corner softness: %.1f×" = "Eckenweichheit: %.1f×";
"notch %d×%d pt" = "Notch %d×%d pt";
"Coffee on: %@" = "Kaffee an: %@";
"Left side when closed" = "Links im geschlossenen Zustand";
"Right side when closed" = "Rechts im geschlossenen Zustand";

/* Espresso */
"%@ + Espresso" = "%@ + Espresso";
"Battery is at %@, Espresso needs more than %@." = "Akku bei %@, Espresso braucht mehr als %@.";
"Espresso needs your password once to allow `pmset disablesleep`." = "Espresso braucht einmal dein Passwort, um `pmset disablesleep` zu erlauben.";
"Couldn't disable lid sleep (pmset failed)." = "Deckel-Ruhezustand konnte nicht deaktiviert werden (pmset fehlgeschlagen).";
"Espresso turned off: battery at %@." = "Espresso ausgeschaltet: Akku bei %@.";
"Rıhtım wants to allow Espresso to keep the Mac awake with the lid closed." = "Rıhtım möchte Espresso erlauben, den Mac bei geschlossenem Deckel wach zu halten.";
"Espresso: keep running with the lid closed" = "Espresso: bei geschlossenem Deckel weiterlaufen";
"Espresso" = "Espresso";
"Espresso (lid closed)" = "Espresso (Deckel zu)";
"Lid sleep is off. Downloads, builds and Claude keep running with the lid closed." = "Deckel-Ruhezustand aus. Downloads, Builds und Claude laufen bei geschlossenem Deckel weiter.";
"Turn off on battery at %@" = "Im Akkubetrieb bei %@ ausschalten";
"Turns Coffee on and runs `pmset disablesleep` so the Mac doesn't sleep when the lid closes. Asks for your password once (a sudoers rule that allows only that command). Lid sleep comes back when Coffee ends, on quit, and after a crash. Don't put the Mac in a bag while Espresso is on: it can get hot." = "Schaltet Kaffee ein und führt `pmset disablesleep` aus, damit der Mac beim Zuklappen nicht schläft. Fragt einmal nach dem Passwort (eine sudoers-Regel nur für diesen Befehl). Der Deckel-Ruhezustand kommt zurück, wenn Kaffee endet, beim Beenden und nach einem Absturz. Den Mac mit Espresso nicht in die Tasche stecken: er kann heiß werden.";
"Espresso on: keeps running with the lid closed" = "Espresso an: läuft bei geschlossenem Deckel weiter";
"Espresso off" = "Espresso aus";
