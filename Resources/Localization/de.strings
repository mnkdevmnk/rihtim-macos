"Data: Open-Meteo (no API key or location permission needed). Refreshes every 15 minutes." = "Daten: Open-Meteo (kein API-Schlüssel, keine Ortungsfreigabe nötig). Aktualisierung alle 15 Minuten.";
"Devices" = "Geräte";
"No devices found" = "Keine Geräte gefunden";
